# SMTP settings for real owner email notifications. Do not commit the real .env file.
# For Gmail: enable two-step verification, create an App Password, then use smtp.gmail.com.
CAMILLA_SMTP_HOST=smtp.gmail.com
CAMILLA_SMTP_PORT=465
CAMILLA_SMTP_USER=behruzoripov123vip17@gmail.com
CAMILLA_SMTP_PASSWORD=PASTE_GOOGLE_APP_PASSWORD_HERE

# Google Identity Services: create a Web application OAuth client in Google Cloud.
# Add http://127.0.0.1:8000 for local testing and your HTTPS domain in Authorized JavaScript origins.
CAMILLA_GOOGLE_CLIENT_ID=PASTE_YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
CAMILLA_GOOGLE_CLIENT_ID=ваш-client-id.apps.googleusercontent.com